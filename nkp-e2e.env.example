# Copy to nkp-e2e.env (chmod 600). Values for the shared dev Prism Central are in
# the team's internal notes; nothing environment-specific lives in this repository.
# NKP dev e2e settings. Copy to ./nkp-e2e.env or ~/.nkp-e2e.env and edit.
# A real environment variable always wins over this file, so a one-off
# override is still:  PC_URL=... ./run_e2e.py <scenario>
#
# Never commit the filled-in copy: it holds credentials.

# --- Prism Central -----------------------------------------------------------
PC_URL=https://<your-prism-central>:9440
NUTANIX_USER=
NUTANIX_PASSWORD=
NUTANIX_PRISM_ELEMENT_CLUSTER_NAME=<prism-element-cluster>
NUTANIX_SUBNET_NAME=<subnet>
NUTANIX_STORAGE_CONTAINER_NAME=SelfServiceContainer

# --- addresses ---------------------------------------------------------------
# each run leases two from this pool: a control-plane VIP and a load balancer
E2E_VIP_POOL=<first-ip>-<last-ip>          # addresses the framework may hand to clusters (VIP + LoadBalancer)

# --- binaries and repos ------------------------------------------------------
# the released nkp used to create baselines and to serve verbs you did not build
NKP_BIN=~/nkp/nkp
# where the source checkouts live (konvoy2, kommander, kommander-applications, charts)
NKP_REPOS_DIR=~/nkp                      # parent of the kommander, konvoy2, charts checkouts
# freeze manifests, the template registry and the claim machinery's state
SPEEDSTART_DIR=~/nkp/e2e-state           # claim/template state; created on first use

# --- your registry, for dev images and charts --------------------------------
# charts are pushed as TAGS on this already-public package, so no new
# private package is created and no visibility flip is ever needed
E2E_CHART_PACKAGE=nkp-dev
GHCR_USER=
GHCR_TOKEN=

# --- optional ----------------------------------------------------------------
# E2E_KUBERNETES_VERSION=v1.33.2
# E2E_CLUSTER_PREFIX=e2e-yourname
# E2E_PAUSE=skip        # make every pause a no-op, for unattended runs
# the charts repo has no release branch; changed-chart detection diffs vs this
E2E_CHARTS_BASE=origin/master
